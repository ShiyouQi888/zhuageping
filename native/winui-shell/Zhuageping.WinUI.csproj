<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Zhuageping_WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Product>抓个屏</Product>
    <Title>抓个屏 WinUI 预览版</Title>
    <AssemblyTitle>抓个屏 WinUI 预览版</AssemblyTitle>
    <Description>本地截图、标注、OCR、贴图与屏幕录制工具</Description>
    <Company>齐世有</Company>
    <Authors>齐世有</Authors>
    <Copyright>Copyright © 2026 齐世有. All rights reserved.</Copyright>
    <Version>0.1.27</Version>
    <AssemblyVersion>0.1.27.0</AssemblyVersion>
    <FileVersion>0.1.27.0</FileVersion>
    <InformationalVersion>0.1.27-preview</InformationalVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\.runtime\ocr-v0.1.0\RapidOCR-json\RapidOCR_json.exe')">
    <Content Include="..\..\.runtime\ocr-v0.1.0\RapidOCR-json\**\*">
      <Link>ocr\RapidOCR-json\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>ocr\RapidOCR-json\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\..\.runtime\ocr-v0.1.0\RapidOCR-json\RapidOCR_json.exe') and Exists('..\..\build\ocr\RapidOCR-json\RapidOCR_json.exe')">
    <Content Include="..\..\build\ocr\RapidOCR-json\**\*">
      <Link>ocr\RapidOCR-json\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>ocr\RapidOCR-json\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="StageCompiledPreview" AfterTargets="Build" Condition="'$(Platform)' == 'x64' and '$(DesignTimeBuild)' != 'true' and '$(Configuration)' == 'Debug'">
    <!-- Shell activation uses AppX, not TargetDir; keep the registered preview current. -->
    <ItemGroup>
      <_CompiledPreviewFile Include="$(TargetPath);$(TargetDir)$(TargetName).exe;$(TargetDir)$(TargetName).pdb;$(TargetDir)$(TargetName).deps.json;$(TargetDir)$(TargetName).runtimeconfig.json;$(TargetDir)*.xbf;$(TargetDir)resources.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompiledPreviewFile)" DestinationFolder="$(TargetDir)AppX" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishRecorderHostForPreview" AfterTargets="Build" Condition="'$(Platform)' == 'x64' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <RecorderHostPublishDirectory>$(TargetDir)recorder</RecorderHostPublishDirectory>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\recorder-host\ZhuagepingRecorderHost.csproj&quot; --configuration $(Configuration) --runtime win-x64 --self-contained true --output &quot;$(RecorderHostPublishDirectory)&quot;" />
    <ItemGroup>
      <_RecorderHostFile Include="$(RecorderHostPublishDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RecorderHostFile)" DestinationFiles="@(_RecorderHostFile->'$(TargetDir)AppX\recorder\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageNativePublishAssets" AfterTargets="Publish" Condition="'$(Platform)' == 'x64'">
    <!-- WinUI file-system publishing omits loose XAML binaries and the child host. -->
    <ItemGroup>
      <_NativePublishAsset Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativePublishAsset)" DestinationFiles="@(_NativePublishAsset->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_PublishAsset Include="$(TargetDir)Assets\**\*" />
      <_PublishRecorder Include="$(TargetDir)recorder\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishAsset)" DestinationFiles="@(_PublishAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PublishRecorder)" DestinationFiles="@(_PublishRecorder->'$(PublishDir)recorder\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)ocr\RapidOCR-json\RapidOCR_json.exe')" Text="OCR engine is missing from the native publish output." />
  </Target>
</Project>
